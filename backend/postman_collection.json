            }
          }
        },
        {
          "name": "Settings - Get Public Store Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/settings",
              "host": ["{{baseUrl}}"],
              "path": ["user", "settings"]
            }
          }
        },
        {
          "name": "Order - Place Online Order (COD)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddress\": \"Banani, Dhaka\",\n  \"paymentMethod\": \"COD\",\n  \"notes\": \"Call on arrival\",\n  \"items\": [\n    {\n      \"id\": \"1\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/orders",
              "host": ["{{baseUrl}}"],
              "path": ["user", "orders"]
            }
          }
        },
        {
          "name": "Order - Place Online Order (SSLCommerz)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },

            "body": {
              "mode": "raw",
              "raw": "{\n  \"deliveryAddress\": \"Gulshan 1, Dhaka\",\n  \"paymentMethod\": \"SSLCOMMERZ\",\n  \"items\": [\n    {\n      \"id\": \"1\",\n      \"quantity\": 5\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/orders",
              "host": ["{{baseUrl}}"],
              "path": ["user", "orders"]
            }
          }
        },
        {
          "name": "Order - Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["user", "orders", "my-orders"]
            }
          }
        },
        {
          "name": "AI Assistant - Chat & OCR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"sess-001\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Sergel 20mg ache?\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/ai-assistant",
              "host": ["{{baseUrl}}"],
